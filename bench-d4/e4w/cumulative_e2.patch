+                         "+r"(r[i + 6]), "+r"(r[i + 7]));
+        __nanosleep(10000);
+        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t1));
+    } while (t1 - t0 < ns);
+    unsigned s = 0;
+#pragma unroll
+    for (int i = 0; i < 48; ++i) s += r[i];
