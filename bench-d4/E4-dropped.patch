+int regacc_main(const char* path, int count) {
+    namespace kc = strata::kernels::cpu;
+    if (!kc::cpu_avx512_ok()) { std::printf("this CPU has no AVX-512 rows: nothing to compare\n"); return 0; }
+    constexpr size_t STRIDE = 2764816, LAYER = 512 * STRIDE;
+    std::ifstream f(path, std::ios::binary);
+    f.seekg(0, std::ios::end);
+    const int layers = (int) ((size_t) f.tellg() / LAYER);
+    if (layers < 1) { std::fprintf(stderr, "cannot read %s\n", path); return 2; }
+    std::mt19937 rng(20261121);
+    int bad = 0, rows = 0;
+    {   // random blocks first (every code, wide scales)
+        std::vector<uint8_t> w(BLOB);
+        std::uniform_int_distribution<int> byte(0, 255), sc(0x20, 0x5f);
+        for (size_t o = 0; o + BLK <= BLOB - 16; o += BLK) {
+            for (int s = 0; s < 4; ++s) w[o + s] = (uint8_t) sc(rng);
+            for (int q = 4; q < BLK; ++q) w[o + q] = (uint8_t) byte(rng);
+        }
+        const float one[4] = {1.f, 1.f, 1.f, 1.f};
+        std::memcpy(w.data() + BLOB - 16, one, sizeof one);
+        bad += regacc_compare(w.data(), rng, rows);
+    }
+    std::vector<uint8_t> b(BLOB);
+    std::uniform_int_distribution<int> ex(0, 511);
+    for (int i = 0; i < count; ++i) {
+        const int layer = i % layers, e = ex(rng);
+        f.clear();
+        f.seekg((std::streamoff) (layer * LAYER + (size_t) e * STRIDE));
+        if (!f.read((char*) b.data(), (std::streamsize) b.size())) { std::fprintf(stderr, "cannot read %s\n", path); return 2; }
+        const int d = regacc_compare(b.data(), rng, rows);
+        if (d) std::printf("layer %d expert %d: %d token rows differ\n", layer, e, d);
+        bad += d;
+    }
+    std::printf("regacc vs acc[]: random blocks + %d real experts (%d layers), 1..9 tokens, %d output rows: %s (%d differing "
+                "token vectors)\n", count, layers, rows, bad ? "DIFFER" : "bit-identical", bad);
+    // one core, one expert (gate/up + down) out of L2/L3, best of 50
+    Acts ax(N, 8, rng), ah(FF, 8, rng);
+    std::vector<float> ff((size_t) 8 * (ROWS / 2)), out((size_t) 8 * N);
+    float* fp[8];
+    float* op[8];
+    for (int t = 0; t < 8; ++t) { fp[t] = ff.data() + (size_t) t * (ROWS / 2); op[t] = out.data() + (size_t) t * N; }
+    std::printf("\n%-6s %12s %12s %8s   (one expert, gate/up + down, one core, cached; best of 50)\n", "tokens", "acc[] us",
+                "regacc us", "speedup");
+    for (int nt : {1, 2, 3, 4, 7, 8}) {
+        double best[2] = {1e30, 1e30};
+        for (int rep = 0; rep < 50; ++rep)
+            for (int reg = 0; reg < 2; ++reg) {
+                kc::nvfp4_512_set_regacc(reg);
+                const double t0 = now_ms();
+                kc::nvfp4_512_gu_rows(b.data(), ROW_BYTES, (size_t) (ROWS / 2) * ROW_BYTES, N, ax.p.data(), nt, fp, 0, ROWS / 2, 1.f, 1.f);
+                kc::nvfp4_512_rows(b.data() + (size_t) ROWS * ROW_BYTES, D_ROW, FF, ah.p.data(), nt, op, 0, N, 1.f);
+                best[reg] = std::fmin(best[reg], now_ms() - t0);
+            }
+        std::printf("%-6d %12.1f %12.1f %7.2fx\n", nt, best[0] * 1e3, best[1] * 1e3, best[0] / best[1]);
+    }
+    kc::nvfp4_512_set_regacc(-1);
+    std::printf("\nRESULT: %s\n", bad ? "MISMATCH" : "regacc bit-identical");
+    return bad ? 1 : 0;
+}
