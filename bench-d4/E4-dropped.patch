+// --regacc: both AVX-512 row paths on the same inputs; any differing float fails
+int regacc_compare(const uint8_t* b, std::mt19937& rng, int& rows_checked) {
+    namespace kc = strata::kernels::cpu;
+    constexpr int NT = 9, F = ROWS / 2;
+    float tail[4];
+    std::memcpy(tail, b + BLOB - 16, sizeof tail);
+    const size_t up_off = (size_t) F * ROW_BYTES, d_off = (size_t) ROWS * ROW_BYTES;
+    Acts ax(N, NT, rng), ah(FF, NT, rng);
+    std::vector<std::vector<float>> f0(NT, std::vector<float>(F)), f1 = f0, o0(NT, std::vector<float>(N)), o1 = o0;
+    std::vector<float*> pf0(NT), pf1(NT), po0(NT), po1(NT);
+    for (int t = 0; t < NT; ++t) { pf0[t] = f0[t].data(); pf1[t] = f1[t].data(); po0[t] = o0[t].data(); po1[t] = o1[t].data(); }
+    int bad = 0;
+    for (int nt = 1; nt <= NT; ++nt) {
+        for (int reg = 0; reg < 2; ++reg) {
+            kc::nvfp4_512_set_regacc(reg);
+            kc::nvfp4_512_gu_rows(b, ROW_BYTES, up_off, N, ax.p.data(), nt, (reg ? pf1 : pf0).data(), 0, F, tail[0], tail[1]);
+            kc::nvfp4_512_rows(b + d_off, D_ROW, FF, ah.p.data(), nt, (reg ? po1 : po0).data(), 0, N, tail[2]);
+        }
+        for (int t = 0; t < nt; ++t) {
+            bad += std::memcmp(f0[t].data(), f1[t].data(), sizeof(float) * F) != 0;
+            bad += std::memcmp(o0[t].data(), o1[t].data(), sizeof(float) * N) != 0;
+            rows_checked += F + N;
+        }
+    }
+    kc::nvfp4_512_set_regacc(-1);
+    return bad;
+}
