+// STRATA_MTP_HEAD_L2: the scanned rows' 2-bit words and scales into L2 (no register gets a value: the scan's bits are unchanged)
+static __global__ void __launch_bounds__(256) draft_proxy_l2_kernel(const uint8_t* __restrict__ wq, const uint8_t* __restrict__ sc,
+                                                                    const int32_t* __restrict__ n_rows_dev) {
+#if !defined(__HIPCC__)
+    const size_t t = (size_t) tiles(*n_rows_dev);
+    const size_t nw = t * kNw4 * 32 * 16, ns = t * kNw4 * 32 * 4;
+    const size_t step = (size_t) gridDim.x * blockDim.x * 128, o0 = ((size_t) blockIdx.x * blockDim.x + threadIdx.x) * 128;
+    for (size_t o = o0; o < nw; o += step) asm volatile("prefetch.global.L2 [%0];" ::"l"(wq + o));
+    for (size_t o = o0; o < ns; o += step) asm volatile("prefetch.global.L2 [%0];" ::"l"(sc + o));
+#endif
+}
+
+void draft_proxy_l2(const void* proxy, const int32_t* n_rows_dev, int64_t n_cap, int blocks, cudaStream_t stream) {
+    draft_proxy_l2_kernel<<<(unsigned) (blocks > 0 ? blocks : 1), 256, 0, stream>>>((const uint8_t*) proxy,
+                                                                        (const uint8_t*) scales(const_cast<void*>(proxy), n_cap), n_rows_dev);
+    check("draft_proxy_l2");
+}
+
 void draft_proxy_final2(bool on) { final2_flag() = on ? 1 : 0; }
 
 size_t draft_proxy_bytes(int64_t n_cap) { return (size_t) tiles(n_cap) * kNw4 * 32 * (16 + 4); }
